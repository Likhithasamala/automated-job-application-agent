# ---------------------------------------------------------------------------
# Example environment file.
#
# NOTE: n8n stores credentials in its own encrypted credential store, NOT in a
# .env file. You normally add these through the n8n UI (Credentials → Add).
# This file exists so you can see, at a glance, every secret the workflow needs
# and where each one comes from.
#
# Copy to .env and fill in if you self-host n8n and prefer env-var injection.
# NEVER commit the filled-in .env — it is already in .gitignore.
# ---------------------------------------------------------------------------

# --- Apify -----------------------------------------------------------------
# apify.com → Console → Settings → Integrations → Personal API token
# Free tier: $5 of credit per month. Scraper costs $0.002 per post.
APIFY_API_TOKEN=

# --- Groq (LLM) ------------------------------------------------------------
# console.groq.com → API Keys → Create API Key
# Free tier is sufficient for a full run.
GROQ_API_KEY=

# --- Gmail OAuth2 ----------------------------------------------------------
# Google Cloud Console → enable Gmail API → Credentials → OAuth client ID
# One set per sending account. The workflow rotates across three.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

GMAIL_CLIENT_ID_2=
GMAIL_CLIENT_SECRET_2=

GMAIL_CLIENT_ID_3=
GMAIL_CLIENT_SECRET_3=

# --- Your details ----------------------------------------------------------
# Google Drive file ID of your resume PDF (sharing: "Anyone with the link").
# From https://drive.google.com/file/d/<THIS_PART>/view
RESUME_DRIVE_FILE_ID=

# Where the nightly summary email is sent.
SUMMARY_EMAIL_TO=

# --- Self-hosted n8n only --------------------------------------------------
# Used by the helper scripts if you patch the workflow over the REST API.
N8N_HOST=https://your-n8n-host.example.com
N8N_API_KEY=
